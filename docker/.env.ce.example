# ══════════════════════════════════════════════════════════════════════
# LiveContext CE - Environment Configuration
# From the repository root: cp docker/.env.ce.example .env
# Compose reads .env automatically. Keep it private and back it up securely.
# ══════════════════════════════════════════════════════════════════════

# === LLM providers (or connect LiveContext Cloud in the app) ===
# Uncomment the provider you use and supply its key, or configure it in the app.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=

# === Optional LLM Providers ===
# MISTRAL_API_KEY=
# DEEPSEEK_API_KEY=

# === Social Login (leave empty to disable) ===
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# === Credential Encryption (auto-generated if left empty) ===
# On first boot, LiveContext generates unique encryption keys and persists
# them to a Docker volume. You only need to set these if you want to
# provide your own keys (e.g., migrating from another instance).
# WARNING: Changing these after credentials have been stored will make
# existing encrypted credentials unreadable.
# CREDENTIAL_ENCRYPTION_PASSWORD=
# CREDENTIAL_ENCRYPTION_SALT=

# === Ports and remote access ===
# Both ports must be reachable from the machine you browse from: the web UI is on
# FRONTEND_PORT and the browser talks to the backend on BACKEND_PORT.
#
# Leave these commented to use your Compose file's defaults.
# Public / npm installation: 3000 and 8080. Private development Compose: 8870 and 18080.
# Uncomment to override; no image rebuild is needed.
# FRONTEND_PORT=3000
# BACKEND_PORT=8080
# NO TRAILING SLASH on either URL below: a trailing slash yields
# https://host//api/credentials/oauth2/callback for OAuth, which will not match the
# redirect URI you registered with the provider.
#
# PUBLIC_BASE_URL: where the BROWSER reaches the web UI. Consumed by OAUTH2_FRONTEND_URL,
# so a LAN install that leaves it empty sends OAuth users back to their own machine.
PUBLIC_BASE_URL=
# Browser-facing backend URL. For LAN/server installs, set this and PUBLIC_BASE_URL
# explicitly so OAuth callbacks and email links point to the server. A local-only
# installation can leave them empty. Example with two HTTPS proxy hostnames:
#   PUBLIC_BASE_URL=https://app.example.com
#   GATEWAY_PUBLIC_URL=https://api.example.com
GATEWAY_PUBLIC_URL=

# === Database (CHANGE before exposing the deployment beyond localhost) ===
DB_PASSWORD=postgres

# === Object Storage (MinIO - CHANGE BOTH before exposing beyond localhost) ===
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# === Optional add-ons (repository installation only) ===
# Keep profiles and app settings together in this file so every restart preserves them.
# Both add-ons:
# COMPOSE_PROFILES=renderer,browser-agent
# SCREENSHOT_RENDERER_URL=http://screenshot-renderer:8094
# WEBSEARCH_ENABLED=true
# Renderer only: COMPOSE_PROFILES=renderer plus SCREENSHOT_RENDERER_URL.
# Browser agent only: COMPOSE_PROFILES=browser-agent plus WEBSEARCH_ENABLED=true.

# === LiveContext Cloud (optional) ===
# CE consumes the cloud marketplace in read/acquire mode out of the box
# (MARKETPLACE_MODE=remote). The release includes the LiveContext production
# signing public key for catalog bundles. Override trusted keys only when using
# another trusted signing authority; ordinary installs need no manual key setup.
# CATALOG_BUNDLE_TRUSTED_KEYS=

# === Bridge (Claude Code CLI - optional) ===
# Uses your Claude subscription instead of API credits.
# Requires: Claude Code CLI installed + bridge running locally
#   cd mcp/bridge && node server.mjs
# BRIDGE_ENABLED=true
# BRIDGE_URL=http://host.docker.internal:8093

# === Update check (optional) ===
# Once a day this install asks the public release feed whether a newer version
# exists; that is what puts the "Update available" badge on Settings > Information.
# The request carries the running version and an anonymous install id (a random
# UUID stored in your own database, derived from nothing: no IP, no hostname, no
# account), so live self-hosted installs can be counted. See README-CE.md.
# Keep the update check but stay unidentified:
# CE_VERSIONCHECK_SENDINSTALLID=false
# Or drop the request entirely (no update badge either):
# CE_VERSIONCHECK_ENABLED=false

# === What's new panel (optional) ===
# After an upgrade, a one-time panel describes the newest change in the version you are
# running, with an image or a short clip. It ships inside the image, so it makes no network
# request and works offline; each user sees it once and older entries are never replayed.
# Remove it entirely (no panel, no sidebar entry):
# CHANGELOG_ENABLED=false

# ---------------------------------------------------------------------------
# SMTP (e-mail)
#
# Optional to boot, and required for anyone to recover a forgotten password:
# without a relay the reset form still says a link is on its way and nothing is
# ever sent. Set both MAIL_USERNAME and MAIL_PASSWORD or neither.
# ---------------------------------------------------------------------------
# Left COMMENTED, not blank: an empty value binds as an empty host rather than
# falling back to the localhost default, and an empty host counts as NON-local,
# so a later MAIL_SMTP_STARTTLS=false would refuse the boot citing host ''.
#MAIL_HOST=smtp.your-provider.example
# 1025 is the dev-relay convention the compose defaults to (Mailpit). A real
# relay is 587 (submission, with STARTTLS): set MAIL_HOST and MAIL_PORT together,
# because a real host on 1025 is a connection refused.
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@your-domain.example
# STARTTLS is ON by default and opportunistic: a local relay that does not offer
# it is unaffected. Turning it off against a NON-LOCAL host makes the app refuse
# to start, on purpose.
MAIL_SMTP_STARTTLS=true
# A relay with a private-CA certificate is handled by trusting the CA, not by
# waiving verification: put its PEM in ./extra-ca (mounted at /app/extra-ca) and
# the container imports it at startup.
