<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.apimarketplace</groupId>
    <artifactId>apimarketplace-parent</artifactId>
    <version>0.1.6</version>
    <packaging>pom</packaging>
    <name>API Marketplace - Parent</name>

    <licenses>
        <license>
            <name>LiveContext Sustainable Use License 1.1</name>
            <url>https://github.com/livecontext-ai/livecontext-ce/blob/main/LICENSE</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <properties>
        <java.version>21</java.version>
        <!-- 3.5.16 (from 3.5.14) brings Spring Framework 6.2.19, Spring Security 6.5.11,
             Spring Data 2025.0.13, Micrometer 1.15.12 and Logback 1.5.34, the fixed
             versions of advisories the 3.5.14 set carried (spring-webmvc/webflux/expression
             CVE-2026-41842/-41845/-41850, spring-data-commons CVE-2026-41695/-41716,
             micrometer CVE-2026-40983/-40984). What 3.5.16 still gets wrong is pinned in
             dependencyManagement below. -->
        <spring-boot.version>3.5.16</spring-boot.version>
        <!-- 2025.0.3 brings spring-cloud-gateway 4.3.5: 2025.0.0 shipped gateway 4.3.0
             (CVE-2025-41243, fixed 4.3.1; CVE-2025-41253, fixed 4.3.2). -->
        <spring-cloud.version>2025.0.3</spring-cloud.version>
        <maven.compiler.release>${java.version}</maven.compiler.release>
        <maven.compiler.source>${java.version}</maven.compiler.source>
        <maven.compiler.target>${java.version}</maven.compiler.target>
        <spring-boot.repackage.skip>false</spring-boot.repackage.skip>

        <!-- 🔧 Aligne Flyway partout -->
        <flyway.version>11.12.0</flyway.version>

        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- Security pins - MUST stay BEFORE the spring-boot-dependencies import
                 (Maven dependencyManagement is first-declaration-wins; property overrides
                 like tomcat.version do NOT work with a BOM import, only with the starter
                 parent). Each pin names what the Boot version above still manages and the
                 advisory it carries; drop a pin once Boot manages that version (or newer).
                 Checked against OSV on 2026-10-01 for Boot 3.5.16.
                 TOMCAT, NETTY AND JACKSON (the next three pins) exist ONLY for those CVEs and
                 are NEWER than what Spring Boot 3.5.16 was tested with (a patch line ahead of
                 its BOM). Remove all three at the next Boot bump: re-add one only if the new
                 Boot still manages a version below the fix, never carry it forward by habit. -->
            <!-- Boot 3.5.16 manages Tomcat 10.1.55 (CVE-2026-65182, CVE-2026-65905,
                 CVE-2026-68525, all critical, fixed 10.1.58). -->
            <dependency>
                <groupId>org.apache.tomcat.embed</groupId>
                <artifactId>tomcat-embed-core</artifactId>
                <version>10.1.60</version>
            </dependency>
            <dependency>
                <groupId>org.apache.tomcat.embed</groupId>
                <artifactId>tomcat-embed-el</artifactId>
                <version>10.1.60</version>
            </dependency>
            <dependency>
                <groupId>org.apache.tomcat.embed</groupId>
                <artifactId>tomcat-embed-websocket</artifactId>
                <version>10.1.60</version>
            </dependency>
            <!-- Boot 3.5.16 manages Netty 4.1.135.Final (CVE-2026-75595 critical in
                 netty-handler, CVE-2026-55831/-55833/-56745/-56819/-59901 high in the
                 codecs, fixed 4.1.136/4.1.137). Same 4.1 line, so reactor-netty and
                 lettuce are unaffected. -->
            <dependency>
                <groupId>io.netty</groupId>
                <artifactId>netty-bom</artifactId>
                <version>4.1.138.Final</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- Boot 3.5.16 manages Jackson 2.21.4 (CVE-2026-68497, CVE-2026-89407,
                 CVE-2026-89425, CVE-2026-91776, CVE-2026-91777, high, fixed 2.21.6/2.21.7). -->
            <dependency>
                <groupId>com.fasterxml.jackson</groupId>
                <artifactId>jackson-bom</artifactId>
                <version>2.21.7</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- Boot 3.5.16 manages the PostgreSQL driver 42.7.11 (CVE-2026-54291, high,
                 fixed 42.7.12). -->
            <dependency>
                <groupId>org.postgresql</groupId>
                <artifactId>postgresql</artifactId>
                <version>42.7.13</version>
            </dependency>
            <!-- Boot 3.5.16 manages Log4j 2.24.3 (log4j-api reaches the classpath through
                 the log4j-to-slf4j bridge; CVE-2026-49844, fixed 2.25.5). -->
            <dependency>
                <groupId>org.apache.logging.log4j</groupId>
                <artifactId>log4j-bom</artifactId>
                <version>2.25.5</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- Boot 3.5.16 manages commons-lang3 3.17.0 (CVE-2025-48924, uncontrolled
                 recursion in ClassUtils.getClass, fixed 3.18.0). -->
            <dependency>
                <groupId>org.apache.commons</groupId>
                <artifactId>commons-lang3</artifactId>
                <version>3.18.0</version>
            </dependency>
            <!-- testcontainers pulls commons-compress 1.24.0 (CVE-2024-25710, CVE-2024-26308,
                 fixed 1.26.0). 1.27.1 is the version POI 5.4.0 is compiled against, already
                 forced in orchestrator-service. -->
            <dependency>
                <groupId>org.apache.commons</groupId>
                <artifactId>commons-compress</artifactId>
                <version>1.27.1</version>
            </dependency>
            <!-- commons-compress 1.27.1 (above) is built against commons-io 2.16.1 and calls
                 API added there, but nothing managed commons-io: catalog-service resolved
                 2.15.1 through swagger-parser 2.1.22, so compress could fail at runtime with
                 NoSuchMethodError on the path that reads an archive. Boot does not manage it. -->
            <dependency>
                <groupId>commons-io</groupId>
                <artifactId>commons-io</artifactId>
                <version>2.18.0</version>
            </dependency>
            <!-- Boot does not manage nimbus-jose-jwt. 9.37.4 (the version Spring Security
                 6.5.x's oauth2-jose declares) fixes CVE-2025-53864 (deeply nested JSON DoS)
                 and keeps CVE-2023-52428 (PBES2 p2c DoS, fixed 9.37.3) closed. Managed here
                 so the explicit dependency (auth-service, gateway) and every transitive pull
                 agree. -->
            <dependency>
                <groupId>com.nimbusds</groupId>
                <artifactId>nimbus-jose-jwt</artifactId>
                <version>9.37.4</version>
            </dependency>
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>${spring-cloud.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <modules>
        <module>test-support</module>
        <module>common-lib</module>
        <module>agent-common</module>
        <module>shared-agent-lib</module>
        <module>shared-sse-lib</module>
        <module>datasource-client</module>
        <module>agent-client</module>
        <module>interface-client</module>
        <module>trigger-client</module>
        <module>publication-client</module>
        <module>auth-client</module>
        <module>storage-client</module>
        <module>credential-client</module>
        <module>conversation-client</module>
        <module>notification-client</module>
        <module>common-security</module>
        <module>trigger-service</module>
        <module>catalog-service</module>
        <module>conversation-service</module>
        <module>auth-service</module>
        <module>common-storage-service</module>
        <module>storage-service</module>
        <module>datasource-service</module>
        <module>agent-service</module>
        <module>interface-service</module>
        <module>publication-service</module>
        <module>migration-service</module>
        <module>orchestrator-service</module>
    </modules>

    <build>
        <finalName>app</finalName>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <version>${spring-boot.version}</version>
                    <configuration>
                        <skip>${spring-boot.repackage.skip}</skip>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.11.0</version>
                    <configuration>
                        <release>${java.version}</release>
                        <parameters>true</parameters>
                    </configuration>
                </plugin>
                <!--
                    git-commit-id: stamps the runnable artifact with build version + commit sha
                    + build time into classpath:git.properties, which Spring Boot exposes as a
                    GitProperties bean (VersionController reads it for GET /api/version).

                    Declared here (config + execution) but NOT activated globally: only the two
                    runnable hosts that serve /api/version activate it (auth-service for cloud,
                    monolith-service for CE) by declaring the bare plugin. Keeping it off the
                    client/library JARs avoids a git.properties on every classpath entry; in the
                    CE fat jar the monolith's own BOOT-INF/classes/git.properties wins anyway.

                    git.commit.id.abbrev (the short sha) is the from-source build identity:
                    VersionInfo.resolveVersion surfaces it as "dev-<sha>" when no release tag
                    (APP_VERSION) is stamped, instead of the Maven SNAPSHOT version. So abbrev +
                    build.time MUST stay in the includeOnlyProperties allow-list below.

                    Defensive flags (failOn*=false, offline=true) so a build without a reachable
                    .git (e.g. a Docker layer that did not COPY .git) degrades to "no git info"
                    instead of failing - VersionController falls back to version "dev" / null sha.
                    offline=true means no VCS remote is ever contacted, so a VCS-connection failure
                    cannot occur (the plugin has no separate "skip connection failure" toggle; these
                    three flags are the complete graceful-degradation set for v9.0.1).
                -->
                <plugin>
                    <groupId>io.github.git-commit-id</groupId>
                    <artifactId>git-commit-id-maven-plugin</artifactId>
                    <version>10.0.1</version>
                    <configuration>
                        <generateGitPropertiesFile>true</generateGitPropertiesFile>
                        <failOnNoGitDirectory>false</failOnNoGitDirectory>
                        <failOnUnableToExtractRepoInfo>false</failOnUnableToExtractRepoInfo>
                        <offline>true</offline>
                        <dateFormat>yyyy-MM-dd'T'HH:mm:ss'Z'</dateFormat>
                        <dateFormatTimeZone>UTC</dateFormatTimeZone>
                        <includeOnlyProperties>
                            <includeOnlyProperty>^git.build.version$</includeOnlyProperty>
                            <includeOnlyProperty>^git.build.time$</includeOnlyProperty>
                            <includeOnlyProperty>^git.commit.id.abbrev$</includeOnlyProperty>
                            <includeOnlyProperty>^git.commit.time$</includeOnlyProperty>
                            <includeOnlyProperty>^git.branch$</includeOnlyProperty>
                        </includeOnlyProperties>
                    </configuration>
                    <executions>
                        <execution>
                            <id>get-the-git-infos</id>
                            <phase>initialize</phase>
                            <goals>
                                <goal>revision</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>

    <!-- CE Monolith profile: builds the single-JAR community edition -->
    <profiles>
        <profile>
            <id>ce</id>
            <modules>
                <module>monolith-service</module>
            </modules>
            <properties>
                <!--
                    In CE profile, service modules produce regular JARs (not fat JARs)
                    so they can be used as dependencies by monolith-service.
                    The spring-boot-maven-plugin repackage is skipped globally via this property.
                    Only monolith-service overrides this back to false in its own pom.
                -->
                <spring-boot.repackage.skip>true</spring-boot.repackage.skip>
            </properties>
            <build>
                <plugins>
                    <!--
                        CE jars must not carry the cloud/dev-only Spring profile files.
                        The public CE image is built from the PRIVATE repo (publish-ce.yml),
                        so anything packaged into the jars ships publicly (inside the
                        monolith fat jar's BOOT-INF/lib) even though the repo export
                        excludes these files (deploy/ce-export/exclude-paths.txt); a secret
                        committed to one of them would bypass every export gate.

                        Excluding at the JAR level (not <resources>) because (a) a parent
                        profile's <resources> does not propagate to child modules, while
                        inherited plugin configuration does, and (b) target/classes keeps
                        the files, so local `-Pce test` runs are unaffected. The `ce`
                        runtime profile never loads local/dev/prod, and cloud builds
                        (no -Pce) are unaffected. publish-ce.yml's "Image content gate"
                        fails the release if this ever regresses.
                    -->
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-jar-plugin</artifactId>
                        <version>3.4.1</version>
                        <configuration>
                            <excludes>
                                <!-- **/ also covers Spring's classpath:/config/ location. -->
                                <exclude>**/application-local.*</exclude>
                                <exclude>**/application-dev.*</exclude>
                                <exclude>**/application-prod.*</exclude>
                            </excludes>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

</project>
